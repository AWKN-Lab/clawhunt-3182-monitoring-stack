{
  "uid": "dnmon-postgresql",
  "title": "PostgreSQL 总览 · PostgreSQL Overview",
  "description": "PostgreSQL 层：连接数占 max_connections 比例、TPS、慢查询数、复制延迟、死锁数、膨胀 Top10 表、磁盘占用。数据源为 postgres_exporter（本次验收使用本地 mock exporter，不连生产库）。",
  "tags": ["dnmon", "postgresql", "database"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": {"from": "now-3h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "env", "label": "环境", "type": "custom",
        "query": "dev", "current": {"text": "dev", "value": "dev"},
        "options": [{"text": "dev", "value": "dev", "selected": true}],
        "includeAll": false, "multi": false, "hide": 0
      },
      {
        "name": "node", "label": "节点", "type": "query",
        "datasource": {"type": "prometheus", "uid": "dnmon-prom"},
        "query": {"query": "label_values(pg_up{env=\"$env\"}, instance)", "refId": "node"},
        "refresh": 1, "includeAll": true, "allValue": ".*", "multi": true,
        "current": {"text": "All", "value": "$__all"}, "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "连接数占 max_connections 比例",
      "datasource": {"type": "prometheus", "uid": "dnmon-prom"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "dnmon-prom"}, "refId": "A",
        "expr": "100 * sum without (datname) (pg_stat_database_numbackends{env=\"$env\",instance=~\"$node\"}) / pg_settings_max_connections{env=\"$env\",instance=~\"$node\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "id": 2, "type": "timeseries", "title": "TPS（提交 + 回滚）",
      "datasource": {"type": "prometheus", "uid": "dnmon-prom"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "dnmon-prom"}, "refId": "A",
        "expr": "sum(rate(pg_stat_database_xact_commit{env=\"$env\",instance=~\"$node\"}[$__rate_interval])) + sum(rate(pg_stat_database_xact_rollback{env=\"$env\",instance=~\"$node\"}[$__rate_interval]))",
        "legendFormat": "tps"
      }]
    },
    {
      "id": 3, "type": "timeseries", "title": "慢查询数（5 分钟新增）",
      "datasource": {"type": "prometheus", "uid": "dnmon-prom"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "dnmon-prom"}, "refId": "A",
        "expr": "increase(pg_slow_queries_total{env=\"$env\",instance=~\"$node\"}[5m])",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "id": 4, "type": "timeseries", "title": "复制延迟（秒）",
      "datasource": {"type": "prometheus", "uid": "dnmon-prom"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "dnmon-prom"}, "refId": "A",
        "expr": "pg_replication_lag_seconds{env=\"$env\",instance=~\"$node\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "id": 5, "type": "timeseries", "title": "死锁数（5 分钟新增）",
      "datasource": {"type": "prometheus", "uid": "dnmon-prom"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "dnmon-prom"}, "refId": "A",
        "expr": "increase(pg_stat_database_deadlocks{env=\"$env\",instance=~\"$node\"}[5m])",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "id": 6, "type": "timeseries", "title": "数据库磁盘占用",
      "datasource": {"type": "prometheus", "uid": "dnmon-prom"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "dnmon-prom"}, "refId": "A",
        "expr": "pg_database_size_bytes{env=\"$env\",instance=~\"$node\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "id": 7, "type": "table", "title": "膨胀最严重的前 10 张表",
      "datasource": {"type": "prometheus", "uid": "dnmon-prom"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto"}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Value"}, "properties": [{"id": "unit", "value": "bytes"}]}
        ]
      },
      "options": {"showHeader": true, "sortBy": [{"displayName": "Value", "desc": true}]},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "dnmon-prom"}, "refId": "A",
        "expr": "topk(10, pg_table_bloat_bytes{env=\"$env\",instance=~\"$node\"})",
        "format": "table", "instant": true
      }]
    }
  ]
}
