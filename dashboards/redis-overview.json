{
  "uid": "dnmon-redis",
  "title": "Redis 总览 · Redis Overview",
  "description": "Redis 层：内存使用率、命中率、连接数、evicted_keys。数据源为 redis_exporter（本次验收使用本地 mock exporter，不连生产库）。",
  "tags": ["dnmon", "redis", "cache"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": {"from": "now-3h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "env", "label": "环境", "type": "custom",
        "query": "dev", "current": {"text": "dev", "value": "dev"},
        "options": [{"text": "dev", "value": "dev", "selected": true}],
        "includeAll": false, "multi": false, "hide": 0
      },
      {
        "name": "node", "label": "节点", "type": "query",
        "datasource": {"type": "prometheus", "uid": "dnmon-prom"},
        "query": {"query": "label_values(redis_up{env=\"$env\"}, instance)", "refId": "node"},
        "refresh": 1, "includeAll": true, "allValue": ".*", "multi": true,
        "current": {"text": "All", "value": "$__all"}, "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "内存使用率",
      "datasource": {"type": "prometheus", "uid": "dnmon-prom"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "dnmon-prom"}, "refId": "A",
        "expr": "100 * redis_memory_used_bytes{env=\"$env\",instance=~\"$node\"} / clamp_min(redis_memory_max_bytes{env=\"$env\",instance=~\"$node\"}, 1)",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "id": 2, "type": "timeseries", "title": "命中率",
      "datasource": {"type": "prometheus", "uid": "dnmon-prom"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "dnmon-prom"}, "refId": "A",
        "expr": "rate(redis_keyspace_hits_total{env=\"$env\",instance=~\"$node\"}[$__rate_interval]) / clamp_min(rate(redis_keyspace_hits_total{env=\"$env\",instance=~\"$node\"}[$__rate_interval]) + rate(redis_keyspace_misses_total{env=\"$env\",instance=~\"$node\"}[$__rate_interval]), 1e-9)",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "id": 3, "type": "timeseries", "title": "连接数",
      "datasource": {"type": "prometheus", "uid": "dnmon-prom"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "dnmon-prom"}, "refId": "A",
        "expr": "redis_connected_clients{env=\"$env\",instance=~\"$node\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "id": 4, "type": "timeseries", "title": "evicted_keys（区间驱逐数）",
      "datasource": {"type": "prometheus", "uid": "dnmon-prom"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "dnmon-prom"}, "refId": "A",
        "expr": "increase(redis_evicted_keys_total{env=\"$env\",instance=~\"$node\"}[$__rate_interval])",
        "legendFormat": "{{instance}}"
      }]
    }
  ]
}
